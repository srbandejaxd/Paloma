[Site "?"]
[Date "????.??.??"]
[Round "?"]
[White "Same-coloured Bishops: Bishop + Pawn vs. Bishop"]
[Black "Example B"]
[Result "*"]
[FEN "4B3/4K3/5P2/6k1/8/1b6/8/8 b - - 0 1"]
[SetUp "1"]

Kf4
{ The only move to make a draw: Black moves his king to e5 so he will reach the position of example A.   1...Kf5 ?  2.Bf7  Bc2  3.Be6+  And White wins. }
*

[Event "?"]
[Site "?"]
[Date "????.??.??"]
[Round "?"]
[White "Same-coloured Bishops: Bishop + Pawn vs. Bishop"]
[Black "Example C"]
[Result "*"]
[FEN "5B2/5K2/6P1/5k2/8/8/1b6/8 w - - 0 1"]
